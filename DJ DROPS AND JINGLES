    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #07070c;
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: #f0f0ff;
      line-height: 1.5;
      padding: 1.5rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #12121a; }
    ::-webkit-scrollbar-thumb { background: #5f5fff; border-radius: 10px; }

    .app-wrapper { max-width: 1440px; margin: 0 auto; width: 100%; }

    /* Header */
    .top-bar {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
      margin-bottom: 2.5rem; padding-bottom: 1rem;
      border-bottom: 1px solid rgba(120, 120, 255, 0.2);
    }
    .logo-area h1 {
      font-family: 'Syne', sans-serif; font-weight: 800; font-size: 2.2rem; letter-spacing: 3px;
      background: linear-gradient(135deg, #c0c0ff, #7a7aff, #4a4aff);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
      text-shadow: 0 0 30px rgba(90, 90, 255, 0.5); line-height: 1.2;
    }
    .logo-area .sub {
      font-size: 0.8rem; color: #8888bb; letter-spacing: 3px; text-transform: uppercase; margin-top: 4px;
      font-weight: 600;
    }
    .header-right { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; }
    .contact-chip {
      background: #14141f; border: 1px solid #2f2f5a; border-radius: 60px;
      padding: 0.65rem 1.5rem; display: flex; align-items: center; gap: 0.75rem;
      font-size: 0.9rem; color: #bbbbee; box-shadow: 0 0 20px rgba(80, 80, 200, 0.2);
      backdrop-filter: blur(4px); transition: 0.2s; cursor: pointer;
    }
    .contact-chip i { color: #7f7fff; font-size: 1.2rem; }
    .contact-chip a {
      color: #ccccff; text-decoration: none; font-weight: 500; letter-spacing: 0.3px;
      border-bottom: 1px dashed #5f5faa;
    }
    .contact-chip a:hover { color: white; border-bottom-color: #9f9fff; }

    .admin-btn {
      background: #1a1a2e; border: 1px solid #3a3a6a; border-radius: 60px;
      padding: 0.65rem 1.3rem; font-size: 0.8rem; font-weight: 700; color: #9f9fdd;
      cursor: pointer; display: flex; align-items: center; gap: 8px; transition: 0.2s;
      letter-spacing: 0.5px;
    }
    .admin-btn:hover { background: #2a2a4a; border-color: #7a7aff; color: white; }

    /* Store grid */
    .store-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; margin-bottom: 2rem; }
    @media (max-width: 950px) { .store-grid { grid-template-columns: 1fr; } }

    /* Cards */
    .card {
      background: rgba(16, 16, 28, 0.85); backdrop-filter: blur(10px);
      border: 1px solid #2b2b4a; border-radius: 32px; padding: 1.8rem 2rem;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.8), 0 0 30px rgba(80, 80, 200, 0.15);
      transition: border-color 0.2s, transform 0.2s; display: flex; flex-direction: column;
    }
    .card:hover { border-color: #5b5b9f; transform: translateY(-3px); }
    .card-title {
      display: flex; align-items: center; gap: 0.7rem;
      font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1.3rem;
      letter-spacing: 1px; color: #d0d0ff; margin-bottom: 1.5rem;
      border-left: 4px solid #6a6aff; padding-left: 1rem;
    }
    .card-title i { color: #6a6aff; font-size: 1.4rem; }

    .price-display {
      font-family: 'Syne', sans-serif; font-size: 2.8rem; font-weight: 800; color: white;
      margin-bottom: 0.2rem; letter-spacing: 2px; text-shadow: 0 0 30px rgba(106, 106, 255, 0.5);
    }
    .price-display small { font-size: 1.1rem; font-weight: 500; color: #9f9fdd; letter-spacing: 1px; }
    .price-sub { font-size: 0.85rem; color: #9f9fdd; margin-bottom: 1.5rem; letter-spacing: 0.5px; }

    .feature-list { list-style: none; margin: 1.5rem 0; flex-grow: 1; }
    .feature-list li {
      display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0;
      font-size: 0.9rem; color: #bbbbee; border-bottom: 1px solid rgba(90, 90, 150, 0.15);
    }
    .feature-list li:last-child { border-bottom: none; }
    .feature-list i { color: #6aff6a; font-size: 1rem; width: 20px; text-align: center; }

    .btn-buy {
      border: none; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800;
      padding: 1.2rem 1.8rem; border-radius: 40px; font-size: 1.05rem; cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 0.75rem;
      transition: 0.2s; letter-spacing: 0.8px;
      background: linear-gradient(145deg, #5a5aff, #3a3ac0); color: white;
      box-shadow: 0 10px 25px -5px #3a3aff, 0 0 20px #5a5aff50;
      border: 1.5px solid #7a7aff; margin-top: 1rem; width: 100%;
    }
    .btn-buy:hover {
      background: linear-gradient(145deg, #6a6aff, #4a4ad0);
      box-shadow: 0 10px 30px 0 #4a4aff, 0 0 30px #6a6aff; transform: scale(1.01);
    }
    .btn-buy i { font-size: 1.2rem; }
    .btn-buy.jingle {
      background: linear-gradient(145deg, #ff6a6a, #c03a3a);
      box-shadow: 0 10px 25px -5px #ff3a3a, 0 0 20px #ff5a5a50;
      border-color: #ff7a7a;
    }
    .btn-buy.jingle:hover {
      background: linear-gradient(145deg, #ff7a7a, #d04a4a);
      box-shadow: 0 10px 30px 0 #ff4a4a, 0 0 30px #ff6a6a;
    }

    .badge-popular {
      display: inline-block; background: #ffd966; color: #07070c;
      font-size: 0.65rem; font-weight: 800; padding: 4px 12px; border-radius: 30px;
      letter-spacing: 1px; margin-left: 10px; vertical-align: middle;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    /* Payment info */
    .payment-banner {
      background: #0d0d1a; border-radius: 18px; padding: 1rem 1.2rem;
      margin: 1.2rem 0 0 0; border: 1px solid #2a2a4a;
    }
    .pay-row {
      display: flex; align-items: center; gap: 10px;
      font-size: 0.82rem; color: #b3b3ff; padding: 0.35rem 0;
    }
    .pay-row i { width: 22px; text-align: center; font-size: 1.05rem; }
    .pay-row.mtn i { color: #ffd966; }
    .pay-row.airtel i { color: #ff6a6a; }
    .pay-number { font-weight: 800; color: #ffffff; letter-spacing: 0.8px; font-size: 0.95rem; }
    .pay-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #8a8acc; font-weight: 700; }

    /* Footer */
    .footer-note {
      margin-top: 2.5rem; text-align: center; font-size: 0.8rem; color: #6a6a9a;
      border-top: 1px solid #1e1e36; padding-top: 1.5rem;
      display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem;
    }
    .footer-note i { color: #6a6aff; }
    .footer-note a { color: #b3b3ff; text-decoration: none; border-bottom: 1px dashed #4f4f8f; }

    .small-note { font-size: 0.7rem; color: #6a6a9a; margin-top: 0.8rem; text-align: center; }
    .ugx-highlight { color: #ffd966; font-weight: 700; }

    .copy-btn {
      background: #1e1e33; border: 1px solid #4a4a7a; color: #ccc;
      border-radius: 20px; padding: 0.2rem 0.7rem; font-size: 0.65rem; font-weight: 700;
      cursor: pointer; transition: 0.15s; margin-left: auto; letter-spacing: 0.5px;
    }
    .copy-btn:hover { background: #6a6aff; color: white; border-color: #8a8aff; }

    /* MODAL */
    .modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(4, 4, 10, 0.88);
      backdrop-filter: blur(8px); z-index: 1000; align-items: flex-start; justify-content: center;
      padding: 2rem 1.5rem; overflow-y: auto;
    }
    .modal-overlay.active { display: flex; }

    .modal-box {
      background: #10101c; border: 1px solid #3a3a6a; border-radius: 32px;
      max-width: 680px; width: 100%; padding: 2.2rem 2.4rem;
      box-shadow: 0 30px 80px -20px #000, 0 0 50px #4a4aff33;
      position: relative; margin: auto;
      animation: modalIn 0.25s ease-out;
    }
    @keyframes modalIn {
      from { opacity: 0; transform: translateY(25px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .modal-close {
      position: absolute; top: 1.2rem; right: 1.4rem;
      background: #1e1e33; border: 1px solid #3a3a6a; color: #bbb;
      width: 38px; height: 38px; border-radius: 50%; cursor: pointer;
      font-size: 1.1rem; display: flex; align-items: center; justify-content: center;
      transition: 0.2s; z-index: 2;
    }
    .modal-close:hover { background: #ff4a4a; color: white; border-color: #ff7a7a; }

    .modal-title {
      font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800;
      color: #e0e0ff; margin-bottom: 0.4rem; letter-spacing: 1px;
      padding-right: 2.5rem;
    }
    .modal-sub { font-size: 0.9rem; color: #9f9fdd; margin-bottom: 1.6rem; }

    .checkout-step {
      background: #0a0a14; border: 1px solid #26264a; border-radius: 20px;
      padding: 1.2rem 1.4rem; margin-bottom: 1.2rem;
    }
    .checkout-step h4 {
      font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1.5px;
      color: #8a8acc; margin-bottom: 0.9rem; display: flex; align-items: center; gap: 8px;
    }
    .checkout-step h4 i { color: #6a6aff; }

    .form-field { margin-bottom: 1rem; }
    .form-field label {
      display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 1.2px; color: #9f9fdd; margin-bottom: 0.35rem;
    }
    .form-field input, .form-field select, .form-field textarea {
      width: 100%; background: #0b0b16; border: 1.5px solid #2f2f55;
      border-radius: 14px; padding: 0.75rem 1rem; font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.9rem; color: #efefff; outline: none; transition: 0.2s;
    }
    .form-field input:focus, .form-field select:focus, .form-field textarea:focus {
      border-color: #6a6aff; box-shadow: 0 0 0 3px rgba(106, 106, 255, 0.2);
    }
    .form-field input::placeholder, .form-field textarea::placeholder { color: #5f5f8f; }

    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 560px) { .two-col { grid-template-columns: 1fr; } }

    .pay-options { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
    .pay-option {
      background: #0d0d1a; border: 2px solid #2f2f55; border-radius: 18px;
      padding: 1rem 0.8rem; text-align: center; cursor: pointer; transition: 0.2s;
      user-select: none;
    }
    .pay-option:hover { border-color: #5a5a9a; }
    .pay-option.selected { border-color: #6a6aff; background: #181833; box-shadow: 0 0 20px #6a6aff44; }
    .pay-option .pay-icon { font-size: 1.8rem; margin-bottom: 0.3rem; }
    .pay-option.mtn .pay-icon { color: #ffd966; }
    .pay-option.airtel .pay-icon { color: #ff6a6a; }
    .pay-option .pay-name { font-weight: 800; font-size: 0.9rem; color: white; }
    .pay-option .pay-number { font-size: 0.8rem; color: #bbbbee; letter-spacing: 0.8px; margin-top: 2px; }
    .pay-option .pay-tag { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1px; color: #8a8acc; margin-top: 4px; }

    .order-summary {
      background: linear-gradient(145deg, #15152a, #0d0d1a);
      border: 1px solid #3a3a6a; border-radius: 18px; padding: 1.1rem 1.3rem;
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.4rem;
      flex-wrap: wrap; gap: 1rem;
    }
    .order-summary .label { font-size: 0.8rem; color: #9f9fdd; }
    .order-summary .value { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: #ffd966; }

    .btn-confirm {
      width: 100%; border: none; font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800;
      padding: 1.1rem; border-radius: 40px; font-size: 1rem; cursor: pointer;
      background: linear-gradient(145deg, #3aff8a, #1fa85a); color: #04140a;
      letter-spacing: 0.8px; display: flex; align-items: center; justify-content: center; gap: 0.7rem;
      box-shadow: 0 10px 25px -5px #1fa85a, 0 0 20px #3aff8a44; transition: 0.2s;
      text-decoration: none;
    }
    .btn-confirm:hover { background: linear-gradient(145deg, #5affaa, #2fc86a); transform: scale(1.01); }
    .btn-confirm:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    .checkout-note {
      font-size: 0.72rem; color: #7a7aaf; text-align: center; margin-top: 1rem; line-height: 1.6;
    }

    /* Success receipt */
    .receipt { text-align: center; padding: 1rem 0; }
    .receipt .success-icon {
      font-size: 3.5rem; color: #3aff8a; margin-bottom: 1rem;
      animation: pop 0.4s ease-out;
    }
    @keyframes pop {
      0% { transform: scale(0.3); opacity: 0; }
      70% { transform: scale(1.15); }
      100% { transform: scale(1); opacity: 1; }
    }
    .receipt h3 { font-family: 'Syne', sans-serif; font-size: 1.4rem; color: white; margin-bottom: 0.5rem; }
    .receipt p { font-size: 0.9rem; color: #bbbbee; margin-bottom: 0.4rem; }
    .receipt .ref-code {
      background: #0a0a14; border: 1px dashed #4a4a8a; border-radius: 14px;
      padding: 0.8rem 1rem; margin: 1.2rem 0; font-family: 'Syne', sans-serif;
      color: #ffd966; letter-spacing: 2px; font-weight: 700; font-size: 1rem;
    }
    .receipt .next-steps {
      text-align: left; background: #0d0d1a; border-radius: 16px;
      padding: 1rem 1.2rem; font-size: 0.82rem; color: #bbbbee; margin-top: 1.2rem;
    }
    .receipt .next-steps ol { margin-left: 1.2rem; padding-left: 0.3rem; }
    .receipt .next-steps li { margin-bottom: 0.5rem; }
    .btn-done {
      margin-top: 0.6rem; width: 100%; border: none; font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800; padding: 1rem; border-radius: 40px; font-size: 1rem; cursor: pointer;
      background: #1e1e33; border: 1.5px solid #4a4a7a; color: #cdcdff; transition: 0.2s;
    }
    .btn-done:hover { background: #2a2a4a; border-color: #8a8aff; color: white; }

    /* Toast */
    .toast-message {
      position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%);
      background: #2a2a55; backdrop-filter: blur(15px); border: 1px solid #7a7aff;
      color: white; padding: 0.8rem 2.2rem; border-radius: 60px; font-weight: 600;
      box-shadow: 0 10px 35px #000000aa; z-index: 2000; opacity: 0;
      transition: opacity 0.3s; pointer-events: none; letter-spacing: 0.5px;
      font-size: 0.9rem; max-width: 90vw; text-align: center;
    }
    .toast-message.show { opacity: 1; }

    .card.selected-product { border-color: #3aff8a; box-shadow: 0 0 40px #3aff8a33; }

    /* Admin dashboard */
    .admin-header {
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
    }
    .admin-stats {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1rem; margin-bottom: 1.5rem;
    }
    .stat-box {
      background: #0d0d1a; border: 1px solid #2f2f55; border-radius: 18px;
      padding: 1rem; text-align: center;
    }
    .stat-box .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #8a8acc; }
    .stat-box .stat-value { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: #ffd966; margin-top: 4px; }

    .orders-list { display: flex; flex-direction: column; gap: 0.8rem; }
    .order-item {
      background: #0a0a14; border: 1px solid #26264a; border-radius: 16px;
      padding: 1rem 1.2rem; transition: 0.2s;
    }
    .order-item:hover { border-color: #5a5a9a; }
    .order-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.3rem; }
    .order-ref { font-family: 'Syne', sans-serif; font-weight: 700; color: #ffd966; font-size: 0.9rem; }
    .order-product { font-weight: 700; color: #ddd; font-size: 0.9rem; }
    .order-detail { font-size: 0.75rem; color: #8a8acc; }
    .order-amount { font-weight: 800; color: #3aff8a; font-family: 'Syne', sans-serif; font-size: 0.9rem; }
    .order-actions { display: flex; gap: 0.5rem; margin-top: 0.6rem; flex-wrap: wrap; }
    .order-actions button {
      background: #1e1e33; border: 1px solid #4a4a7a; color: #ccc;
      border-radius: 20px; padding: 0.35rem 0.9rem; font-size: 0.7rem; font-weight: 700;
      cursor: pointer; transition: 0.2s; letter-spacing: 0.5px;
    }
    .order-actions button:hover { background: #6a6aff; color: white; border-color: #8a8aff; }
    .order-actions .btn-del:hover { background: #ff4a4a; border-color: #ff7a7a; }
    .empty-state {
      text-align: center; padding: 3rem 1rem; color: #6a6a9a;
    }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; }

    /* hidden whatsapp link */
    .hidden-wa {
      color: transparent;
      text-decoration: none;
      font-size: 0;
    }
    .hidden-wa i {
      color: #6aff6a;
      font-size: 1.2rem;
      margin-left: 6px;
      opacity: 0.6;
      transition: 0.2s;
    }
    .hidden-wa:hover i {
      opacity: 1;
      transform: scale(1.1);
    }
  </style>
</head>
