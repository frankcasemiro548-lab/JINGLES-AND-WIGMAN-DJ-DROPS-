          </div>

          <div class="admin-stats">
            <div class="stat-box">
              <div class="stat-label">Total Orders</div>
              <div class="stat-value">${orders.length}</div>
            </div>
            <div class="stat-box">
              <div class="stat-label">Revenue</div>
              <div class="stat-value">${totalRevenue.toLocaleString()} <span style="font-size:0.7rem;">UGX</span></div>
            </div>
            <div class="stat-box">
              <div class="stat-label">DJ Drops</div>
              <div class="stat-value">${djCount}</div>
            </div>
            <div class="stat-box">
              <div class="stat-label">Jingles</div>
              <div class="stat-value">${jingleCount}</div>
            </div>
            <div class="stat-box">
              <div class="stat-label">Pending</div>
              <div class="stat-value" style="color:#ffd966;">${pendingCount}</div>
            </div>
          </div>

          ${ordersHtml}

          <div style="margin-top:1.5rem; display:flex; gap:0.8rem; flex-wrap:wrap;">
            <button class="btn-done" id="exportBtn" style="flex:1; margin:0;"><i class="fas fa-download"></i> EXPORT CSV</button>
            <button class="btn-done" id="clearAllBtn" style="flex:1; margin:0; color:#ff9a9a; border-color:#5a2a2a;"><i class="fas fa-trash"></i> CLEAR ALL</button>
          </div>

          <div class="checkout-note" style="margin-top:1rem;">
            <i class="fas fa-info-circle"></i> Orders are stored in this browser. Export regularly to keep records.
          </div>
        `;

        openModal(html);

        document.getElementById('closeModalBtn').addEventListener('click', closeModal);

        document.querySelectorAll('.btn-mark-paid').forEach(btn => {
          btn.addEventListener('click', function() {
            if (updateOrderStatus(this.dataset.ref, 'paid')) {
              showToast('✅ Marked as PAID: ' + this.dataset.ref);
              renderAdminDashboard();
            }
          });
        });

        document.querySelectorAll('.btn-mark-complete').forEach(btn => {
          btn.addEventListener('click', function() {
            if (updateOrderStatus(this.dataset.ref, 'completed')) {
              showToast('🏁 Marked as COMPLETED: ' + this.dataset.ref);
              renderAdminDashboard();
            }
          });
        });

        document.querySelectorAll('.btn-resend-email').forEach(btn => {
          btn.addEventListener('click', function() {
            const ref = this.dataset.ref;
            const orders = getOrders();
            const order = orders.find(o => o.ref === ref);
            if (!order) return;
            const subject = encodeURIComponent(`Follow-up: ${order.ref} - ${order.product}`);
            const body = encodeURIComponent(`Hello ${order.customerName},\n\nYour order ${order.ref} (${order.product}) is being processed.\n\nAmount: ${Number(order.price).toLocaleString()} UGX\nStatus: ${order.status}\n\nThank you,\nFrank Sports`);
            window.location.href = `mailto:${order.customerEmail}?subject=${subject}&body=${body}`;
          });
        });

        document.querySelectorAll('.btn-del').forEach(btn => {
          btn.addEventListener('click', function() {
            if (confirm('Delete this order permanently?')) {
              if (deleteOrder(this.dataset.ref)) {
                showToast('🗑️ Order deleted');
                renderAdminDashboard();
              }
            }
          });
        });

        document.getElementById('exportBtn').addEventListener('click', function() {
          const orders = getOrders();
          if (orders.length === 0) { showToast('No orders to export', false); return; }
          const headers = ['Reference', 'Date', 'Product', 'Type', 'Price (UGX)', 'Status', 'Method', 'Pay Number', 'Customer', 'Phone', 'Email', 'DJ Name', 'Voice', 'Length', 'Phrase'];
          const rows = orders.map(o => [
            o.ref, new Date(o.date).toLocaleString(), o.product, o.productType,
            o.price, o.status, o.method, o.payNumber, o.customerName,
            o.customerPhone, o.customerEmail, o.djName, o.voice, o.length,
            (o.phrase || '').replace(/"/g, '""')
          ]);
          const csv = [headers, ...rows].map(row => row.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n');
          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `frank_sports_orders_${new Date().toISOString().slice(0,10)}.csv`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('📥 CSV exported: ' + orders.length + ' orders');
        });

        document.getElementById('clearAllBtn').addEventListener('click', function() {
          if (confirm('Delete ALL orders from this browser? This cannot be undone.')) {
            localStorage.removeItem(CONFIG.STORAGE_KEY);
            showToast('🗑️ All orders cleared');
            renderAdminDashboard();
          }
        });
      }

      // ============ EVENT BINDINGS ============
      document.querySelectorAll('.btn-buy').forEach(btn => {
        btn.addEventListener('click', function() {
          openCheckout({
            type: this.dataset.product,
            name: this.dataset.name,
            price: parseInt(this.dataset.price, 10)
          });
        });
      });

      adminBtn.addEventListener('click', renderAdminDashboard);

      contactChip.addEventListener('click', function(e) {
        if (e.target.tagName !== 'A') {
          copyText(CONFIG.EMAIL, null);
        }
      });

      // ============ WELCOME ============
      window.addEventListener('load', function() {
        setTimeout(() => {
          showToast('💡 Click BUY on any product · MTN & Airtel accepted · Real checkout', true);
        }, 900);
      });

    })();
  </script>
</body>
</html>
